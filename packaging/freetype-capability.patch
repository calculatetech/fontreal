--- a/builds/unix/unix-cc.in
+++ b/builds/unix/unix-cc.in
@@ -78,6 +78,8 @@
 #
 #   We use our own FreeType configuration files overriding defaults.
 #
+CXX := @CXX@
+CXXFLAGS := @CXXFLAGS@
 CPPFLAGS := @CPPFLAGS@
 CFLAGS   := -c @XX_CFLAGS@ @CFLAGS@ \
             $DFT_CONFIG_CONFIG_H="<ftconfig.h>" \
@@ -122,13 +124,13 @@
 
 # Library linking.
 #
-LINK_LIBRARY = $(LIBTOOL) --mode=link $(CCraw) -o $@ $(OBJECTS_LIST) \
+LINK_LIBRARY = $(LIBTOOL) --tag=CXX --mode=link $(CXX) -o $@ $(OBJECTS_LIST) \
                           -rpath $(libdir) -version-info $(version_info) \
-                          $(LDFLAGS) -no-undefined \
+                          $(LDFLAGS) -lstdc++ -lm -Wl,--version-script=$(FONTREAL_EXPORTS) -no-undefined \
                           -export-symbols $(EXPORTS_LIST)
 
 # For the demo programs.
 FT_DEMO_CFLAGS := @FT_DEMO_CFLAGS@
-FT_DEMO_LDFLAGS := @FT_DEMO_LDFLAGS@
+FT_DEMO_LDFLAGS := @FT_DEMO_LDFLAGS@ -lstdc++ -lm
 
 # EOF
--- a/src/base/rules.mk
+++ b/src/base/rules.mk
@@ -75,6 +75,12 @@
 # Default extensions objects
 #
 BASE_EXT_OBJ := $(BASE_EXT_SRC:$(BASE_DIR)/%.c=$(OBJ_DIR)/%.$O)
+BASE_EXT_OBJ += $(OBJ_DIR)/fontreal_coverage.$O $(OBJ_DIR)/fontreal_v2_coverage.$O
+
+$(OBJ_DIR)/fontreal%coverage.$O: $(BASE_DIR)/fontreal%coverage.cpp $(BASE_DIR)/fontreal%coverage.h $(FREETYPE_H)
+	$(LIBTOOL) --tag=CXX --mode=compile $(CXX) $(CXXFLAGS) $(CPPFLAGS) \
+	  -std=c++17 -fPIC -fvisibility=hidden -fvisibility-inlines-hidden \
+	  $(INCLUDE_FLAGS) -c $< -o $@
 
 
 # Base layer object(s)
