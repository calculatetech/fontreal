#!/bin/sh
set -eu

directory=${XDG_CONFIG_HOME:-"$HOME/.config"}/fontreal
usage() {
    printf '%s\n' 'Usage: fontreal-session enable|disable|status|profile [o|k3]' >&2
    exit 2
}
profile() {
    if [ -f "$directory/profile" ] &&
        { printf 'k3\n' | cmp -s - "$directory/profile" || printf k3 | cmp -s - "$directory/profile"; }; then
        printf '%s\n' k3
    else
        printf '%s\n' o
    fi
}
case ${1:-status} in
    profile) [ "$#" -le 2 ] || usage ;;
    *) [ "$#" -le 1 ] || usage ;;
esac
case ${1:-status} in
    profile)
        if [ "$#" -eq 1 ]; then
            profile
        else
            case $2 in o|k3) ;; *) usage ;; esac
            umask 077
            mkdir -p "$directory"
            printf '%s\n' "$2" > "$directory/profile"
            chmod 600 "$directory/profile"
        fi
        ;;
    enable)
        umask 077
        mkdir -p "$directory"
        : > "$directory/enabled"
        printf '%s\n' 'Fontreal enabled for your next Plasma login.'
        ;;
    disable)
        rm -f "$directory/enabled"
        printf '%s\n' 'Fontreal disabled for your next Plasma login.'
        ;;
    status)
        if [ -f "$directory/enabled" ]; then
            printf '%s\n' 'Next-login preference: enabled'
        else
            printf '%s\n' 'Next-login preference: disabled'
        fi
        printf 'Next-login profile: %s\n' "$(profile)"
        printf 'Current process: rendering=%s blend=%s contrast=%s fitting=%s profile=%s\n' \
            "${FONTREAL_RENDERING:-0}" "${FONTREAL_BLEND:-}" "${FONTREAL_CONTRAST:-}" "${FONTREAL_FITTING:-}" "${FONTREAL_PROFILE:-}"
        ;;
    *)
        usage
        ;;
esac
