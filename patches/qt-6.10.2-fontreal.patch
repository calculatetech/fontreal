+bool QFontEngineFT::fontrealEnabled() const
+{
+    static const bool enabled = qgetenv("FONTREAL_RENDERING") == "1";
+    if (!enabled || !freetype || !FT_IS_SCALABLE(freetype->face)
+        || FT_HAS_COLOR(freetype->face))
+        return false;
+    const char *format = FT_Get_Font_Format(freetype->face);
+    return format && qstrcmp(format, "TrueType") == 0;
+}
+
