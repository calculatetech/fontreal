+#if QT_CONFIG(freetype) && defined(__ELF__)
+// The default atlas uses the same font engine for sizing and filling each slot.
+class QSGFontrealGlyphEngine final : public QFontEngine
+{
+public:
+    QSGFontrealGlyphEngine(QFontEngine *engine, const QColor &ink)
+        : QFontEngine(Freetype), m_engine(engine), m_lightInk(ink == Qt::white)
+    {}
+
+    glyph_t glyphIndex(uint ucs4) const override { return m_engine->glyphIndex(ucs4); }
+    int stringToCMap(const QChar *s, int n, QGlyphLayout *g, int *count, ShaperFlags f) const override
+    {
+        return m_engine->stringToCMap(s, n, g, count, f);
+    }
+    glyph_metrics_t boundingBox(glyph_t glyph) override { return m_engine->boundingBox(glyph); }
+    QFixed capHeight() const override { return m_engine->capHeight(); }
+    qreal maxCharWidth() const override { return m_engine->maxCharWidth(); }
+    bool supportsHorizontalSubPixelPositions() const override
+    {
+        return m_engine->supportsHorizontalSubPixelPositions();
+    }
+    void addGlyphsToPath(glyph_t *glyphs, QFixedPoint *positions, int count,
+                         QPainterPath *path, QTextItem::RenderFlags flags) override
+    {
+        m_engine->addGlyphsToPath(glyphs, positions, count, path, flags);
+    }
+
+    glyph_metrics_t alphaMapBoundingBox(glyph_t glyph, const QFixedPoint &phase,
+                                        const QTransform &transform, GlyphFormat) override
+    {
+        QImage coverage;
+        QPoint bearing;
+        qt_fontrealV3GrayGlyph(m_engine, glyph, &phase, transform.m22(), m_lightInk,
+                              &coverage, &bearing);
+        if (coverage.isNull())
+            return m_engine->alphaMapBoundingBox(glyph, phase, transform, Format_A8);
+
+        glyph_metrics_t metrics;
+        metrics.x = bearing.x();
+        metrics.y = bearing.y();
+        metrics.width = coverage.width();
+        metrics.height = coverage.height();
+        m_pending.insert(QTextureGlyphCache::GlyphAndSubPixelPosition(glyph, phase),
+                         std::move(coverage));
+        return metrics;
+    }
+
+    QImage bitmapForGlyph(glyph_t glyph, const QFixedPoint &phase,
+                          const QTransform &transform, const QColor &) override
+    {
+        auto coverage = m_pending.take(QTextureGlyphCache::GlyphAndSubPixelPosition(glyph, phase));
+        if (coverage.isNull())
+            qt_fontrealV3GrayGlyph(m_engine, glyph, &phase, transform.m22(), m_lightInk,
+                                  &coverage, nullptr);
+        if (coverage.isNull())
+            coverage = m_engine->alphaMapForGlyph(glyph, phase, transform).convertToFormat(QImage::Format_Alpha8);
+
+        QImage ink(coverage.size(), QImage::Format_ARGB32_Premultiplied);
+        for (int y = 0; y < ink.height(); ++y) {
+            const uchar *source = coverage.constScanLine(y);
+            auto *target = reinterpret_cast<QRgb *>(ink.scanLine(y));
+            for (int x = 0; x < ink.width(); ++x)
+                target[x] = qRgba(0, 0, 0, source[x]);
+        }
+        return ink;
+    }
+
+    void clearPending() { m_pending.clear(); }
+
+private:
+    QFontEngine *m_engine;
+    bool m_lightInk;
+    QHash<QTextureGlyphCache::GlyphAndSubPixelPosition, QImage> m_pending;
+};
+#endif
