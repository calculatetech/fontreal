+  /* Private diagnostic: native mutual round segments define the gate. */
+  static FT_Pos
+  af_latin_compute_curve_width( AF_GlyphHints hints, AF_Dimension dim,
+                               FT_Pos width, FT_Pos delta,
+                               AF_Edge base, AF_Edge stem )
+  {
+    FT_Pos fitted = af_latin_compute_stem_width( hints, dim, width, delta,
+                                                 base->flags, stem->flags );
+    FT_Pos result = fitted;
+    AF_Segment first = base->first;
+    AF_Segment seg = first;
+    AF_AxisHints axis = &hints->axis[dim];
+
+    if ( dim == AF_DIMENSION_VERT &&
+         AF_LATIN_HINTS_DO_VERT_SNAP( hints ) &&
+         AF_LATIN_HINTS_DO_STEM_ADJUST( hints ) && first )
+    {
+      FT_TRACE5(( "FR_PAIR_BEGIN input=%ld fitted=%ld extra=%d\n", width, fitted,
+                    ((AF_LatinMetrics)hints->metrics)->axis[dim].extra_light ));
+      do
+      {
+        AF_Segment link = seg->link;
+        FT_TRACE5(( "FR_PAIR_SEG id=%td next=%td flags=%u link=%td link_flags=%u "
+                    "back=%td link_edge=%td stem_edge=%td\n",
+                    seg - axis->segments, seg->edge_next - axis->segments, seg->flags,
+                    link ? link - axis->segments : -1,
+                    link ? link->flags : 0,
+                    link && link->link ? link->link - axis->segments : -1,
+                    link && link->edge ? link->edge - axis->edges : -1,
+                    stem - axis->edges ));
+        if ( link && link->link == seg && link->edge == stem &&
+             (seg->flags & link->flags & AF_EDGE_ROUND) )
+        {
+          result += width < 0 ? -8 : 8;
+          break;
+        }
+        seg = seg->edge_next;
+      } while ( seg != first );
+      FT_TRACE5(( "FR_PAIR_END output=%ld\n", result ));
+    }
+    return result;
+  }
+
