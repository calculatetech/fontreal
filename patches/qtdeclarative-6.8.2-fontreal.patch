 QT_BEGIN_NAMESPACE
+
+bool qsg_fontrealEnabled()
+{
+    static const bool enabled = qgetenv("FONTREAL_RENDERING") == "1";
+    return enabled;
+}
+
+bool qsg_fontrealFont(QFontEngine *engine)
+{
+    return engine && engine->type() == QFontEngine::Freetype
+            && static_cast<QFontEngineFT *>(engine)->fontrealEnabled();
+}
+
+bool qsg_fontrealWriteView(QRhi *rhi)
+{
+    auto *ctx = QOpenGLContext::currentContext();
+    return qsg_fontrealEnabled() && rhi && rhi->backend() == QRhi::OpenGLES2
+            && ctx && !ctx->isOpenGLES() && ctx->hasExtension("GL_EXT_framebuffer_sRGB")
+            && ctx->hasExtension("GL_ARB_texture_storage") && ctx->hasExtension("GL_ARB_texture_view");
+}
+
+bool qsg_fontrealLinearTarget(QSGMaterialShader::RenderState &state)
+{
+    static const bool linear = qgetenv("FONTREAL_BLEND") != "encoded";
+    if (!qsg_fontrealEnabled() || !linear || !state.rhi() || state.rhi()->backend() != QRhi::OpenGLES2)
+        return false;
+    auto *ctx = QOpenGLContext::currentContext();
+    if (!ctx || ctx->isOpenGLES() || !ctx->hasExtension("GL_EXT_framebuffer_sRGB"))
+        return false;
+    auto *rt = static_cast<const QSGRenderer *>(state.m_data)->renderTarget().rt;
+    if (!rt || rt->sampleCount() != 1)
+        return false;
+    if (rt->resourceType() == QRhiResource::TextureRenderTarget) {
+        const auto &desc = static_cast<QRhiTextureRenderTarget *>(rt)->description();
+        if (desc.colorAttachmentCount() != 1)
+            return false;
+        const auto *tex = static_cast<const QGles2Texture *>(desc.cbeginColorAttachments()->texture());
+        return tex && tex->flags().testFlag(QRhiTexture::FontrealSrgbWrite) && tex->fontrealWriteView;
+    }
+    if (rt->resourceType() != QRhiResource::SwapChainRenderTarget)
+        return false;
+    auto *f = ctx->extraFunctions();
+    GLint draw = 0, read = 0, encoding = 0;
+    f->glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+    f->glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+    const GLuint fbo = ctx->defaultFramebufferObject();
+    f->glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    f->glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, fbo ? GL_COLOR_ATTACHMENT0 : GL_BACK_LEFT,
+                                             GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding);
+    f->glBindFramebuffer(GL_DRAW_FRAMEBUFFER, GLuint(draw));
+    f->glBindFramebuffer(GL_READ_FRAMEBUFFER, GLuint(read));
+    return encoding == GL_SRGB;
+}
 
