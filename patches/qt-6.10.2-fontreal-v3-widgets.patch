+static bool fontrealV3SplitMasks(QImage &gray, QImage &stripes, QPoint origin,
+                                   QRasterBuffer *buffer, const QClipData *clip, QRgb background)
+{
+    QRect visible = QRect(origin, gray.size()).intersected(QRect(0, 0, buffer->width(), buffer->height()));
+    if (clip) {
+        visible &= QRect(clip->xmin, clip->ymin, clip->xmax - clip->xmin, clip->ymax - clip->ymin);
+        const_cast<QClipData *>(clip)->initialize();
+    }
+
+    bool hasStripes = false;
+    for (int y = visible.top(); y <= visible.bottom(); ++y) {
+        auto *coverage = gray.scanLine(y - origin.y());
+        auto *channels = reinterpret_cast<QRgb *>(stripes.scanLine(y - origin.y()));
+        const auto *pixels = reinterpret_cast<const QRgb *>(buffer->scanLine(y));
+        const auto split = [&](int first, int last, int clipCoverage) {
+            for (int x = first; x < last; ++x) {
+                const int sample = x - origin.x();
+                if (clipCoverage == 255 && pixels[x] == background && coverage[sample]) {
+                    coverage[sample] = 0;
+                    hasStripes = true;
+                } else {
+                    channels[sample] = qRgb(0, 0, 0);
+                }
+            }
+        };
+        if (!clip) {
+            split(visible.left(), visible.right() + 1, 255);
+            continue;
+        }
+        const auto &line = clip->m_clipLines[y];
+        for (int i = 0; i < line.count; ++i) {
+            const auto &span = line.spans[i];
+            split(qMax(visible.left(), int(span.x)), qMin(visible.right() + 1, span.x + span.len),
+                  span.coverage);
+        }
+    }
+    return hasStripes;
+}
