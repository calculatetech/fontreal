+QFontEngineFT::FontrealGlyph QFontEngineFT::fontrealV3Glyph(glyph_t glyph, QFixedPoint phase,
+                                                            qreal scale, bool lightInk,
+                                                            bool allowColor) const
+{
+    using namespace fontreal_v3;
+    if (!drawAntialiased() || !FT_IS_SCALABLE(freetype->face) || FT_HAS_COLOR(freetype->face)
+        || isBitmapFont() || fontDef.pixelSize * scale > QT_MAX_CACHED_GLYPH_SIZE)
+        return {};
+
+    FT_Face face = lockFace();
+    const auto unlock = qScopeGuard([this] { unlockFace(); });
+    FT_Matrix originalMatrix;
+    FT_Vector originalPhase;
+    FT_Get_Transform(face, &originalMatrix, &originalPhase);
+    const auto restoreTransform = qScopeGuard([&] {
+        FT_Set_Transform(face, &originalMatrix, &originalPhase);
+    });
+    FT_Vector shift{phase.x.value(), -phase.y.value()};
+    FT_Set_Transform(face, &originalMatrix, &shift);
+
+    const bool scaled = !qFuzzyCompare(scale, qreal(1));
+    const auto restoreSize = qScopeGuard([&] {
+        if (scaled)
+            FT_Set_Char_Size(face, xsize, ysize, 0, 0);
+    });
+    if (scaled && FT_Set_Char_Size(face, qRound(xsize * scale), qRound(ysize * scale), 0, 0))
+        return {};
+
+    const FT_Library library = face->glyph->library;
+    FT_Bool previousNoDarkening = true;
+    const bool cff = qstrcmp(FT_Get_Font_Format(face), "CFF") == 0;
+    const FT_Bool noDarkening = true;
+    const bool changedDarkening = cff
+            && !FT_Property_Get(library, "cff", "no-stem-darkening", &previousNoDarkening)
+            && !previousNoDarkening
+            && !FT_Property_Set(library, "cff", "no-stem-darkening", &noDarkening);
+    const auto restoreDarkening = qScopeGuard([&] {
+        if (changedDarkening)
+            FT_Property_Set(library, "cff", "no-stem-darkening", &previousNoDarkening);
+    });
+
+    constexpr int flags = FT_LOAD_TARGET_NORMAL | FT_LOAD_NO_BITMAP | FT_LOAD_NO_AUTOHINT;
+    const auto loadOutline = [&](int extra) {
+        if (FT_Load_Glyph(face, glyph, flags | extra) || face->glyph->format != FT_GLYPH_FORMAT_OUTLINE)
+            return false;
+        if (embolden)
+            FT_GlyphSlot_Embolden(face->glyph);
+        if (obliquen)
+            FT_GlyphSlot_Oblique(face->glyph);
+        return true;
+    };
+    if (!loadOutline(0))
+        return {};
+
+    FT_Glyph outline = nullptr;
+    if (FT_Get_Glyph(face->glyph, &outline))
+        return {};
+    const auto releaseOutline = qScopeGuard([&] { FT_Done_Glyph(outline); });
+    const FT_GlyphSlot slot = face->glyph;
+    if (FT_Render_Glyph(slot, FT_RENDER_MODE_NORMAL) || slot->bitmap.pixel_mode != FT_PIXEL_MODE_GRAY
+        || slot->bitmap.width > 255 || slot->bitmap.rows > 255)
+        return {};
+
+    const GlyphFrame frame{slot->bitmap_left, slot->bitmap_top, int(slot->bitmap.width),
+                           int(slot->bitmap.rows)};
+    const auto hinted = sampleOutline(library, reinterpret_cast<FT_OutlineGlyph>(outline)->outline,
+                                      frame);
+    if (hinted.pixels.empty())
+        return {};
+
+    bool lightFace = !embolden
+            && (fontDef.weight <= QFont::Light || calculateActualWeight(freetype, face, face_id) <= 350);
+    if (!embolden && freetype->mm_var && !face_id.variableAxes.isEmpty()) {
+        const FT_MM_Var *axes = freetype->mm_var;
+        for (FT_UInt i = 0; i < axes->num_axis; ++i) {
+            if (axes->axis[i].tag == FT_MAKE_TAG('w', 'g', 'h', 't')) {
+                QVarLengthArray<FT_Fixed, 8> coordinates(axes->num_axis);
+                if (!FT_Get_Var_Design_Coordinates(face, axes->num_axis, coordinates.data()))
+                    lightFace = coordinates.at(i) <= 350L * 65536L;
+                break;
+            }
+        }
+    }
+    OutlineSamples unhinted;
+    if (lightFace && loadOutline(FT_LOAD_NO_HINTING))
+        unhinted = sampleOutline(library, slot->outline, frame);
+
+    const auto ink = lightInk ? Ink::Light : Ink::Dark;
+    const double pixels = fontDef.pixelSize * scale;
+    const auto tone = toneCurve(pixels, ink);
+    const bool italic = obliquen || calculateActualItalic(freetype, face, face_id);
+    const auto gray = glyphCoverage(hinted, &unhinted, tone, pixels, ink, italic);
+
+    StripeLayout layout = StripeLayout::None;
+    if (allowColor) {
+        switch (subpixelType) {
+        case Subpixel_None: break;
+        case Subpixel_RGB: layout = StripeLayout::Rgb; break;
+        case Subpixel_BGR: layout = StripeLayout::Bgr; break;
+        case Subpixel_VRGB: layout = StripeLayout::VerticalRgb; break;
+        case Subpixel_VBGR: layout = StripeLayout::VerticalBgr; break;
+        }
+    }
+
+    FontrealGlyph result;
+    result.bearing = QPoint(frame.left, -frame.top);
+    result.gray = QImage(frame.width, frame.height, QImage::Format_Alpha8);
+    if (result.gray.isNull())
+        return {};
+    if (layout != StripeLayout::None)
+        result.stripes = QImage(frame.width, frame.height, QImage::Format_RGB32);
+
+    for (int y = 0; y < frame.height; ++y) {
+        const auto *row = gray.data() + y * frame.width;
+        std::copy_n(row, frame.width, result.gray.scanLine(y));
+        if (result.stripes.isNull())
+            continue;
+        auto *rgb = reinterpret_cast<QRgb *>(result.stripes.scanLine(y));
+        for (int x = 0; x < frame.width; ++x) {
+            auto samples = hinted.stripes(x, y, layout);
+            for (Coverage &sample : samples)
+                sample = tone[sample];
+            const auto channels = projectChannels(row[x], samples, ink);
+            rgb[x] = qRgb(channels[0], channels[1], channels[2]);
+        }
+    }
+    return result;
+}
