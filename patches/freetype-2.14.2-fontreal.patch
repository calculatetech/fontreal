+  FT_BASE_DEF( FT_Bool )
+  ft_fontreal_nearest( FT_Face face, FT_Int32 flags )
+  {
+    const char* contrast = ft_getenv( "FONTREAL_FT_CONTRAST" );
+    return contrast &&
+           ( !ft_strcmp( contrast, "ramp217" ) ||
+             !ft_strcmp( contrast, "raw" ) ) &&
+           ft_fontreal_raster( face, flags );
