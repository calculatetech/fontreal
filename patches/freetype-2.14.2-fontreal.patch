+  static FT_Error
+  ft_fontreal_light( FT_Face face, FT_Bool* light )
+  {
+    TT_OS2* os2 = (TT_OS2*)FT_Get_Sfnt_Table( face, ft_sfnt_os2 );
+    FT_Fixed weight = 400L << 16;
+    FT_MM_Var* axes = NULL;
+    FT_Fixed* coords = NULL;
+    FT_Memory memory = face->memory;
+    FT_Error error = FT_Err_Ok;
+    FT_UInt i;
+
+    if ( os2 && os2->version != 0xFFFF &&
+         os2->usWeightClass >= 1 && os2->usWeightClass <= 1000 )
+      weight = (FT_Fixed)os2->usWeightClass << 16;
+    if ( FT_HAS_MULTIPLE_MASTERS( face ) )
+    {
+      error = FT_Get_MM_Var( face, &axes );
+      if ( error )
+        goto Exit;
+      if ( FT_QNEW_ARRAY( coords, axes->num_axis ) )
+        goto Exit;
+      error = FT_Get_Var_Design_Coordinates( face, axes->num_axis, coords );
+      if ( error )
+        goto Exit;
+      for ( i = 0; i < axes->num_axis; i++ )
+        if ( axes->axis[i].tag == FT_MAKE_TAG( 'w', 'g', 'h', 't' ) )
+          weight = coords[i];
+    }
+    *light = weight < ( 400L << 16 );
+  Exit:
+    FT_FREE( coords );
+    if ( axes )
+      FT_Done_MM_Var( FT_FACE_LIBRARY( face ), axes );
+    return error;
+  }
