+               !selected && ( !contrast ||
+               ( ft_strcmp( contrast, "raw" ) &&
+                 ft_strcmp( contrast, "weighted" ) ) ) ) ) ) )
+      return FALSE;
+
+    if ( selected )
+      return TRUE;
