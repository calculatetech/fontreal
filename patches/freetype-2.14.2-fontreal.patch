+  static void
+  ft_fontreal_ramp217( FT_GlyphSlot slot,
+                       const FT_FontrealSupportRec* support )
+  {
+    FT_Byte* row = slot->bitmap.buffer;
+    FT_UInt x, y;
+
+    for ( y = 0; y < slot->bitmap.rows; y++, row += slot->bitmap.pitch )
+      for ( x = 0; x < slot->bitmap.width; x++ )
+      {
+        FT_Int a = row[x];
+        FT_Pos sx = slot->bitmap_left + (FT_Pos)x - support->left;
+        FT_Pos sy = support->top - slot->bitmap_top + (FT_Pos)y;
+
+        if ( a > 96 && a < 128 )
+          a = 3 * a - 192;
+        else if ( a >= 128 && a < 160 )
+          a = 192 + ( ( a - 128 ) * 50 + 16 ) / 32;
+        else if ( a >= 160 && a < 242 )
+          a = 242;
+        if ( support->bits && sx >= 0 && sy >= 0 &&
+             (FT_ULong)sx < support->width && (FT_ULong)sy < support->rows )
+        {
+          FT_ULong at = (FT_ULong)sy * support->pitch + (FT_ULong)sx / 8;
+          FT_Byte bit = (FT_Byte)( 0x80U >> ( sx & 7 ) );
+          if ( ( support->bits[at] & bit ) &&
+               !( support->bits[support->span + at] & bit ) && a < 217 )
+            a = 217;
+        }
+        row[x] = (FT_Byte)a;
+      }
+  }
