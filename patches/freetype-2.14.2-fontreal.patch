+#ifdef __linux__
+      const char*  executable = (const char*)getauxval( AT_EXECFN );
+      const char*  entry = scope;
+      const char*  end;
+      size_t       length;
+
+
+      /* The kernel's exec name remains available inside browser sandboxes. */
+      if ( !executable )
+        return FALSE;
+      do
+      {
+        end = strchr( entry, ':' );
+        length = end ? (size_t)( end - entry ) : ft_strlen( entry );
+        if ( length == ft_strlen( executable ) &&
+             !ft_strncmp( entry, executable, length ) )
+          return TRUE;
+        entry = end ? end + 1 : NULL;
+      } while ( entry );
+#endif
+      return FALSE;
+    }
