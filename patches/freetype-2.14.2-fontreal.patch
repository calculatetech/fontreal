+  static FT_Bool
+  ft_fontreal_raster( FT_Face   face,
+                      FT_Int32  flags )
+  {
+    const char*  enabled = ft_getenv( "FONTREAL_FT_RENDERING" );
+    const char*  format;
+    const char*  scope = ft_getenv( "FONTREAL_FT_EXECUTABLE" );
+    const char*  contrast = ft_getenv( "FONTREAL_FT_CONTRAST" );
+
+
+    if ( !enabled || ft_strcmp( enabled, "1" ) ||
+         !FT_IS_SCALABLE( face ) || FT_HAS_COLOR( face ) ||
+         ( flags & ( FT_LOAD_NO_SCALE            |
+                     FT_LOAD_NO_RECURSE          |
+                     FT_LOAD_NO_HINTING          |
+                     FT_LOAD_ADVANCE_ONLY        |
+                     FT_LOAD_BITMAP_METRICS_ONLY ) ) )
+      return FALSE;
+
+    format = FT_Get_Font_Format( face );
+    if ( !format ||
+         ( ft_strcmp( format, "TrueType" ) &&
+           ( ft_strcmp( format, "CFF" ) || !contrast ||
+             ft_strcmp( contrast, "raw" ) ) ) )
+      return FALSE;
+
+    if ( scope && *scope )
+    {
+#ifdef __linux__
+      const char*  executable = (const char*)getauxval( AT_EXECFN );
+      const char*  entry = scope;
+      const char*  end;
+      size_t       length;
+
+
+      /* The kernel's exec name remains available inside browser sandboxes. */
+      if ( !executable )
+        return FALSE;
+      do
+      {
+        end = strchr( entry, ':' );
+        length = end ? (size_t)( end - entry ) : ft_strlen( entry );
+        if ( length == ft_strlen( executable ) &&
+             !ft_strncmp( entry, executable, length ) )
+          return TRUE;
+        entry = end ? end + 1 : NULL;
+      } while ( entry );
+#endif
+      return FALSE;
+    }
+
+    return TRUE;
+  }
+
