+  static FT_Bool
+  ft_fontreal_raster( FT_Face   face,
+                      FT_Int32  flags )
+  {
+    const char*  enabled = ft_getenv( "FONTREAL_FT_RENDERING" );
+    const char*  format;
+    const char*  scope = ft_getenv( "FONTREAL_FT_EXECUTABLE" );
