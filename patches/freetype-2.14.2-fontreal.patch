+  static FT_Error
+  ft_fontreal_support( FT_Library library, const FT_Outline* source,
+                       FT_FontrealSupportRec* support )
+  {
+    FT_Outline copy;
+    FT_BBox box;
+    FT_Bitmap bitmap;
+    FT_Memory memory = library->memory;
+    FT_Error error;
+    FT_ULong width, rows, pitch;
+    FT_Pos bottom;
+    FT_Int pass, contour, first = 0;
+
+    if ( !source->n_points )
+      return FT_Err_Ok;
+    error = FT_Outline_New( library, source->n_points,
+                            source->n_contours, &copy );
+    if ( error )
+      return error;
+    error = FT_Outline_Copy( source, &copy );
+    if ( error )
+      goto Exit;
+    /* Native hinter tags must not override the private raster modes. */
+    for ( contour = 0; contour < copy.n_contours; contour++ )
+    {
+      copy.tags[first] &= ~FT_CURVE_TAG_HAS_SCANMODE;
+      first = copy.contours[contour] + 1;
+    }
+    FT_Outline_Get_CBox( &copy, &box );
+    support->left = FT_PIX_FLOOR( box.xMin ) / 64;
+    bottom = FT_PIX_FLOOR( box.yMin ) / 64;
+    support->top = FT_PIX_CEIL( box.yMax ) / 64;
+    width = (FT_ULong)( FT_PIX_CEIL( box.xMax ) / 64 - support->left );
+    rows = (FT_ULong)( support->top - bottom );
+    pitch = width / 8 + ( width % 8 != 0 );
+    if ( !width || !rows )
+      goto Exit;
+    if ( width > FT_UINT_MAX || rows > FT_UINT_MAX ||
+         pitch > FT_INT_MAX || rows > (FT_ULong)FT_LONG_MAX / pitch / 2 )
+    {
+      error = FT_THROW( Raster_Overflow );
+      goto Exit;
+    }
+    support->width = (FT_UInt)width;
+    support->rows = (FT_UInt)rows;
+    support->pitch = (FT_UInt)pitch;
+    support->span = pitch * rows;
+    if ( FT_QALLOC( support->bits, support->span * 2 ) )
+      goto Exit;
+    FT_MEM_ZERO( support->bits, support->span * 2 );
+    FT_Outline_Translate( &copy, -support->left * 64, -bottom * 64 );
+    FT_ZERO( &bitmap );
+    bitmap.width = support->width;
+    bitmap.rows = support->rows;
+    bitmap.pitch = (FT_Int)support->pitch;
+    bitmap.pixel_mode = FT_PIXEL_MODE_MONO;
+    bitmap.num_grays = 2;
+    for ( pass = 0; pass < 2; pass++ )
+    {
+      /* Keep allocation ownership while selecting only dropout flags. */
+      copy.flags = FT_OUTLINE_OWNER |
+                   ( pass ? FT_OUTLINE_IGNORE_DROPOUTS : 0 );
+      bitmap.buffer = support->bits + pass * support->span;
+      error = FT_Outline_Get_Bitmap( library, &copy, &bitmap );
+      if ( error )
+        goto Exit;
+    }
+  Exit:
+    FT_Outline_Done( library, &copy );
+    if ( error )
+      FT_FREE( support->bits );
+    return error;
+  }
