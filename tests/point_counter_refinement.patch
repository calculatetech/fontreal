+static void shrinkCounters(FT_Outline &outline) {
+ if (!outline.n_points) return;
+ auto orientation=FT_Outline_Get_Orientation(&outline);
+ if (orientation==FT_ORIENTATION_NONE) return;
+ std::vector<bool> inner(outline.n_contours,false);
+ int first=0,count=0;
+ for(int c=0;c<outline.n_contours;++c){
+  auto part=outline;auto end=outline.contours[c];end-=first;
+  part.n_contours=1;part.n_points=end+1;part.contours=&end;
+  part.points=outline.points+first;part.tags=outline.tags+first;
+  auto direction=FT_Outline_Get_Orientation(&part);
+  inner[c]=direction!=FT_ORIENTATION_NONE&&direction!=orientation;
+  count+=inner[c];first=outline.contours[c]+1;
+ }
+ if(count<2)return;
+ std::vector<FT_Vector> original(outline.points,outline.points+outline.n_points);
+ check(!FT_Outline_EmboldenXY(&outline,0,FONTREAL_COUNTER_STRENGTH),"counter expansion failed");
+ first=0;
+ for(int c=0;c<outline.n_contours;++c){
+  for(int i=first;i<=outline.contours[c];++i){
+   outline.points[i].x=original[i].x;
+   if(inner[c])outline.points[i].y-=FONTREAL_COUNTER_STRENGTH/2;
+   else outline.points[i].y=original[i].y;
+  }
+  first=outline.contours[c]+1;
+ }
+}
