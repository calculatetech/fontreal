+static QJsonObject dropoutSupport(FT_Library library, const FT_Outline &source) {
+ if (!source.n_points) return {{"width",0},{"height",0},{"left",0},{"top",0},{"with",""},{"ignored",""}};
+ int first=0;
+ for(int c=0;c<source.n_contours;++c){
+  check(!(source.tags[first]&4),"contour scanmode overrides dropout flags");
+  first=source.contours[c]+1;
+ }
+ FT_BBox box;FT_Outline_Get_CBox(&source,&box);
+ int left=int(std::floor(box.xMin/64.0)),bottom=int(std::floor(box.yMin/64.0));
+ int right=int(std::ceil(box.xMax/64.0)),top=int(std::ceil(box.yMax/64.0));
+ int width=right-left,height=top-bottom,stride=(width+7)/8;
+ QJsonObject result{{"width",width},{"height",height},{"left",left},{"top",top}};
+ for(int ignore=0;ignore<2;++ignore){
+  auto outline=source;
+  std::vector<FT_Vector> points(source.points,source.points+source.n_points);
+  for(auto &point:points){point.x-=left*64;point.y-=bottom*64;}
+  outline.points=points.data();outline.flags=ignore?FT_OUTLINE_IGNORE_DROPOUTS:0;
+  QByteArray bytes(stride*height,0);FT_Bitmap bitmap{};
+  bitmap.width=width;bitmap.rows=height;bitmap.pitch=stride;
+  bitmap.buffer=reinterpret_cast<unsigned char*>(bytes.data());
+  bitmap.pixel_mode=FT_PIXEL_MODE_MONO;bitmap.num_grays=2;
+  check(!FT_Outline_Get_Bitmap(library,&outline,&bitmap),"dropout raster failed");
+  result[ignore?"ignored":"with"]=QString::fromLatin1(bytes.toHex());
+ }
+ return result;
+}
